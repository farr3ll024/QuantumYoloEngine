# .gitignore (QuantumYoloEngine)

# -----------------------------
# python bytecode / caches
# -----------------------------
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.cache/
.pytype/
.pyre/

# -----------------------------
# virtual environments
# -----------------------------
.venv/
venv/
env/
ENV/

# -----------------------------
# ide/editor
# -----------------------------
.idea/
.vscode/
*.iml

# macos
.DS_Store

# -----------------------------
# logs
# -----------------------------
*.log
logs/
runtime/logs/
runtime/engine/

# -----------------------------
# local sqlite runtime db
# -----------------------------
paper_trader.db
paper_trader.db-*
*.sqlite
*.sqlite3
*.db
*.db-wal
*.db-shm
runtime/db/

# -----------------------------
# streamlit (never commit secrets)
# -----------------------------
.streamlit/
!.streamlit/config.toml
.streamlit/secrets.toml

# streamlit caches / logs (keep config committed)
.streamlit/cache/
.streamlit/.cache/
.streamlit/logs/

# -----------------------------
# env / secrets
# -----------------------------
.env
.env.*
*.pem
*.key
*.p12
*.pfx

# -----------------------------
# generated data
# -----------------------------
history.csv
history_*.csv
data/
*.parquet
*.feather

# keep a small committed sample if you want:
!history.sample.csv
!data/.gitkeep

# -----------------------------
# build / packaging
# -----------------------------
build/
dist/
*.egg-info/
.eggs/
pip-wheel-metadata/
*.whl

# -----------------------------
# misc / reports
# -----------------------------
coverage.xml
htmlcov/
.coverage
coverage/
reports/
